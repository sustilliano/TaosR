# taos-suite configuration — copy to suite.env and edit.
# Both the taOS side and the open-cowork client read from here so the two
# halves agree on one controller.

# --- taOS controller ---
TAOS_CONTROLLER_URL=http://localhost:6969     # controller HTTP API + web UI
TAOS_LITELLM_URL=http://localhost:4000/v1     # OpenAI-compatible model gateway
TAOS_LOCAL_TOKEN=                             # controller local token (data_dir/.auth_local_token)
TAOS_LLM_KEY=                                 # a LiteLLM key for cowork's model provider

# --- bridge locations on THIS machine (for the MCP connectors) ---
# Clone sustilliano/taosr here (or copy robotics/ tmrfs/ planekey/).
TAOS_BRIDGE_DIR=/opt/taosr
PK_VSE_TOOLCHAIN=/opt/planekey-vse/toolchain
PK_WORKSPACE=/opt/taos-pk-workspace

# --- runtime endpoints the bridges talk to ---
TAOS_TANK_COORDINATOR_URL=http://localhost:8420
TAOS_TMRFS_URL=http://localhost:8080

# --- cowork model choice + bean subject ---
COWORK_MODEL=hermes-3-llama-3.1-8b            # a model id taOS LiteLLM serves
COWORK_BEAN_SCOPES=drive stop ptz_move        # gated capabilities to grant app:open-cowork
